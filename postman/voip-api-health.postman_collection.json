{
  "info": {
    "name": "VoIP Support API Health Checks",
    "_postman_id": "8f3b7c3b-2d8a-4a0d-9d7e-voipdemo001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET - Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://httpbin.org/status/200",
          "protocol": "https",
          "host": [
            "httpbin",
            "org"
          ],
          "path": [
            "status",
            "200"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response time is below 2000 ms', function () { pm.expect(pm.response.responseTime).to.be.below(2000); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET - Simulate 401 Authentication Failure",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid-demo-token"
          }
        ],
        "url": {
          "raw": "https://httpbin.org/status/401",
          "protocol": "https",
          "host": [
            "httpbin",
            "org"
          ],
          "path": [
            "status",
            "401"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Endpoint returns expected 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST - Echo JSON Payload",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"event\":\"call.health_check\",\"call_id\":\"demo-1001\",\"status\":\"ok\"}"
        },
        "url": {
          "raw": "https://httpbin.org/post",
          "protocol": "https",
          "host": [
            "httpbin",
            "org"
          ],
          "path": [
            "post"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Echo contains call_id', function () { pm.expect(pm.response.json().json.call_id).to.eql('demo-1001'); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://httpbin.org"
    }
  ]
}